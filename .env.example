APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=npm-sentinel-api
DATABASE_URL=postgresql+psycopg://npm_sentinel:npm_sentinel@postgres:5432/npm_sentinel
CELERY_BROKER_URL=amqp://npm_sentinel:npm_sentinel@rabbitmq:5672//
# Optional: keep unset to avoid creating reply queues for results.
# CELERY_RESULT_BACKEND=db+postgresql://npm_sentinel:npm_sentinel@postgres:5432/npm_sentinel
NPM_REGISTRY_BASE_URL=https://registry.npmjs.org
NPM_REGISTRY_TIMEOUT_SECONDS=10
TOP_PACKAGES_SOURCE_URL=https://raw.githubusercontent.com/Meyond/npm-top-1000-packages/main/README.md
TOP_PACKAGES_SOURCE_TIMEOUT_SECONDS=10
TOP_PACKAGE_LIMIT=1000
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_METADATA_CONCURRENCY=10
SCHEDULER_SKIP_RUNNING_SCANS=false
TARBALL_DOWNLOAD_TIMEOUT_SECONDS=30
TARBALL_MAX_BYTES=50000000
TARBALL_MAX_MEMBERS=10000
TARBALL_MAX_UNCOMPRESSED_BYTES=100000000
TARBALL_MAX_FILE_BYTES=10000000
TARBALL_MAX_PATH_DEPTH=20
SCANNER_MAX_FILES=10000
SCANNER_MAX_TEXT_FILE_BYTES=1000000
PACKAGE_JSON_MAX_BYTES=1000000
